PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/payflow

# Generate separate random values for these two keys.
API_SECRET_KEY=replace_with_a_long_random_api_secret
DASHBOARD_API_KEY=replace_with_a_different_long_random_dashboard_secret

# Exact public frontend URL; for GitHub Pages, include the repository path.
FRONTEND_URL=http://localhost:3000
# Used for hosted checkout URLs when FRONTEND_URL is not set.
API_BASE_URL=http://localhost:3000

# Safaricom Daraja settings. Use sandbox credentials during development.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PAYBILL=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-public-api.example.com/api/v1/mpesa/callback
